# Copy this file to .env (plain local run), or use .env.development / .env.production
# with the Docker Compose files. Never commit a file with real values filled in.

# --- Server --------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- Database --------------------------------------------------------------
# Real Neon Cloud connection string, or Neon Local's fixed local convention
# (postgres://neon:npg@neon-local:5432/neondb?sslmode=require) when running
# via docker-compose.dev.yml.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# --- Auth --------------------------------------------------------------
# Required — the app refuses to start without this. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_value
JWT_EXPIRES_IN=15m

# --- Arcjet (bot detection / shield / rate limiting) ------------------------
ARCJET_KEY=ajkey_your_key_here

# --- CORS --------------------------------------------------------------
# Comma-separated allowed origins, enforced only when NODE_ENV=production.
# Leave unset in production to block all cross-origin browser requests.
ALLOWED_ORIGINS=https://example.com

# --- Neon Local control plane (docker-compose.dev.yml only; consumed by the
# neon-local container itself, not the app) ---------------------------------
# NEON_API_KEY=napi_your_key_here
# NEON_PROJECT_ID=your-project-id
# PARENT_BRANCH_ID=
